#!name=Bloomberg 文章中英对照 @nickcxm
#!desc=百度主翻译、Google 备用版（20261010-baidu-error-details-1）：填写百度高级版 APP ID 和密钥，编号中英对照，失败自动用 Google，仅在第一段后显示 provider 和百度原始错误码/信息。
#!author=nickcxm
#!homepage=https://github.com/nickcxm/script/tree/main/Bloomberg
#!arguments=enabled:true,provider:baidu,baidu_appid:UNSET,baidu_key:UNSET,remove_ad_config:true,debug:false
#!arguments-desc=enabled/ remove_ad_config/ debug 填 true 或 false；provider 填 baidu 或 google；baidu_appid 填 APP ID，baidu_key 填密钥。UNSET 表示未配置，将使用 Google 备用。翻译服务填 baidu（默认）或 google。百度通用翻译高级版需要 APP ID + 密钥，请在对应参数填写；不要分享含密钥的配置。百度最多6路异步请求，发起间隔150ms，单脚本低于10QPS；多篇同时加载仍共享账号配额。百度失败或未配置凭证时用Google备用，并提示原因。原文和译文保留编号，无法精确匹配时合并展示。

[Script]
nickcxm.bloomberg.translate = type=http-response, pattern=^https:\/\/cdn-mobapi\.bloomberg\.com\/wssmobile\/v1\/stories\/[A-Z0-9]{14}(\?[^#]*)?$, requires-body=true, max-size=1048576, timeout=60, script-path=https://raw.githubusercontent.com/nickcxm/script/a8e5adbc6ac92fbc84309be27d2be394ce4bfe79/Bloomberg/bloomberg.response.js, argument="{"enabled":{{{enabled}}},"removeAdConfig":{{{remove_ad_config}}},"debug":{{{debug}}},"provider":"{{{provider}}}","baiduAppId":"{{{baidu_appid}}}","baiduKey":"{{{baidu_key}}}"}"

[MITM]
hostname = %APPEND% cdn-mobapi.bloomberg.com
